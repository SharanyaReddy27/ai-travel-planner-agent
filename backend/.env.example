# ==============================================================================
# BACKEND ENVIRONMENT CONFIGURATION (SECRET)
# ==============================================================================
# IMPORTANT: These variables are used exclusively by the backend service.
# NEVER commit an actual .env file and NEVER expose these values to the frontend.

# Required: Google Gemini API Key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Gemini primary model (default: gemini-3.8-flash)
# Supported alternatives: gemini-flash-latest, gemini-3.5-flash, gemini-2.5-flash-lite
GEMINI_MODEL=gemini-3.8-flash

# Optional: Production frontend origin(s) for CORS.
# Localhost development ports (5173, 5174, 3000) are allowed by default.
# For production (e.g. Vercel), specify your deployed frontend URL.
# Supports multiple comma-separated URLs: https://app.vercel.app,https://custom-domain.com
FRONTEND_ORIGIN=https://your-frontend-deployment.vercel.app
