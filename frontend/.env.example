# ==============================================================================
# FRONTEND ENVIRONMENT CONFIGURATION (PUBLIC)
# ==============================================================================
# IMPORTANT: Vite exposes variables prefixed with VITE_ to the client bundle.
# NEVER place backend secret keys (such as GEMINI_API_KEY) in frontend configuration.

# Production Backend API URL (e.g., https://ai-travel-planner-backend.onrender.com)
# For local development, leave blank to automatically default to http://127.0.0.1:8000
VITE_API_URL=
